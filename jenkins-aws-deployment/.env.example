# Copy to .env and fill in your own values. NEVER commit .env to git.

# Public IP or DNS name of the EC2 instance running the app
EC2_HOST=ec2-xx-xxx-xxx-xx.compute-1.amazonaws.com

# Port the app container listens on (mapped to host port 80 by Nginx)
APP_PORT=3000

# Version tag baked into the image and shown on the web page
BUILD_VERSION=1.0.0
