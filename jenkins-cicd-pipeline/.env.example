# ---------------------------------------------------------------------------
# Environment configuration for the local Jenkins demo (docker compose).
# Copy to `.env` and fill in YOUR values. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Name of the Jenkins container created by docker compose.
JENKINS_CONTAINER=jenkins

# Jenkins controller HTTP port on the host (8080 is the Jenkins default).
JENKINS_HTTP_PORT=8080

# Jenkins agent (JNLP) port used by inbound build agents.
JENKINS_JNLP_PORT=50000

# Heap size for the Jenkins controller JVM.
JAVA_OPTS=-Dhudson.model.DirectoryBrowserSupport.CSP= -Xmx2048m

# Placeholder admin user created by JCasC on first boot (CHANGE THESE).
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me-admin-password

# Placeholder GitHub credentials used by the pipeline job.
# Create a real PAT in GitHub: Settings > Developer settings > Personal access tokens.
# Use token 'classic' with repo:status, public_repo scopes for public repos.
GITHUB_REPO_URL=https://github.com/<YOUR_USERNAME>/<YOUR_REPO>.git
GITHUB_CREDENTIALS_ID=github-creds
GITHUB_USERNAME=<YOUR_GITHUB_USERNAME>
# The actual token goes into Jenkins Credentials, NEVER into this file.
GITHUB_TOKEN=change-me

# Trivy image tag used for the security scan stage.
TRIVY_IMAGE=aquasec/trivy:0.58.2
