// ============================================================================
// Jenkinsfile - Declarative Pipeline for hello-app
// GitHub (push) -> Jenkins (checkout) -> Build -> Test -> Security -> Docker
// build -> Docker run -> Health check -> Cleanup
//
// RUN IT:
//   1. Create a Pipeline (or Multibranch) job in Jenkins.
//   2. Point SCM to your git repo; the script path is "Jenkinsfile".
//   3. Build now. Blue Ocean (Open Blue Ocean button) is the friendliest view.
//
// CREDENTIALS: no secrets live in this file. The GitHub credentials are
// referenced by ID ("github-creds") and stored in the Jenkins Credentials store.
// ============================================================================

pipeline {
    // Any agent that has: docker CLI, node (>=18), and network access.
    // The bundled jenkins/jenkins image from jenkins/Dockerfile qualifies.
    agent any

    options {
        timestamps()                                                     // human-readable console timestamps
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()                                        // one build at a time avoids port clashes
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        APP_IMAGE      = 'hello-app'
        APP_IMAGE_TAG  = "${BUILD_NUMBER}"
        CONTAINER_NAME = "hello-app-${BUILD_NUMBER}"
        APP_PORT       = '3000'
        // Unique host port per build to avoid clashes: 8090..8099
        HOST_PORT      = "809${(BUILD_NUMBER as Integer) % 10}"
        HEALTH_URL     = "http://localhost:809${(BUILD_NUMBER as Integer) % 10}/health"
        // CREDENTIALS (placeholders only - never commit secrets):
        //   GitHub: create a Username-with-password credential with ID "github-creds"
        //           (Manage Jenkins > Credentials > Global), username = GitHub user,
        //           password = a Personal Access Token with repo scope.
        //   Use it in checkout for private repos: checkout scm plus
        //   'credentialsId: "github-creds"' on the git step.
        //   Docker Hub: credential ID "docker-registry-creds" for `docker login` / push.
    }

    stages {

        stage('Checkout') {
            steps {
                script {
                    try {
                        checkout scm
                        echo 'Checked out: ' + env.GIT_COMMIT
                    } catch (Exception e) {
                        echo 'No SCM configured for this job (freestyle/standalone run). Using existing workspace.'
                    }
                }
            }
        }

        stage('Build & Validate') {
            steps {
                dir('app') {
                    sh 'node --version'
                    sh 'node --check server.js'          // syntax check, no deps required
                    // Informational only (zero deps expected); never blocks the build.
                    sh(script: 'npm ls --depth=0', returnStatus: true)
                    echo 'Copying app into a build workdir (placeholder for real artifact staging).'
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    // `node --test` auto-discovers every test file under test/.
                    // (The literal `node --test test/` form can fail to resolve on
                    // some platforms, so we use the discovery form instead.)
                    // test/example-failing.js is GREEN by default; flip its
                    // EXPECTED constant to 'fail' to demonstrate a red build.
                    sh 'node --test'
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${APP_IMAGE}:${APP_IMAGE_TAG} ./app'
                sh 'docker tag ${APP_IMAGE}:${APP_IMAGE_TAG} ${APP_IMAGE}:latest'
            }
        }

        stage('Security Check (Trivy)') {
            // Trivy is NOT bundled with Jenkins. Guard so the pipeline stays
            // green when it is unavailable, but run a real scan when possible.
            // Runs AFTER Docker Build so the image exists for scanning.
            steps {
                script {
                    if (sh(script: 'command -v trivy', returnStatus: true) == 0) {
                        echo 'Trivy binary present - scanning source tree and image.'
                        sh 'trivy filesystem --exit-code 0 --severity HIGH,MEDIUM ./app || true'
                        sh 'trivy image --exit-code 0 --severity HIGH,CRITICAL --no-progress ${APP_IMAGE}:${APP_IMAGE_TAG} || true'
                    } else if (sh(script: 'docker image inspect aquasec/trivy >/dev/null 2>&1 || command -v trivy >/dev/null 2>&1', returnStatus: true) == 0) {
                        echo 'Trivy via Docker image - scanning app image (gates with exit-code 0 = never blocks).'
                        // exit-code 0 keeps the build green even when vulns are found;
                        // set --exit-code 1 to make HIGH/CRITICAL findings fail the build.
                        sh 'docker run --rm aquasec/trivy:latest image --exit-code 0 --severity HIGH --no-progress ${APP_IMAGE}:${APP_IMAGE_TAG} || true'
                    } else {
                        echo 'Trivy not installed and no Docker image available - SKIPPING security scan.'
                        echo 'To enable: install trivy or run: docker pull aquasec/trivy:latest'
                    }
                }
            }
        }

        stage('Docker Run') {
            steps {
                script {
                    // Best-effort cleanup of a previous container with this name.
                    sh 'docker rm -f ${CONTAINER_NAME} 2>/dev/null || true'
                    sh 'docker run -d --name ${CONTAINER_NAME} -p ${HOST_PORT}:${APP_PORT} ${APP_IMAGE}:${APP_IMAGE_TAG}'
                    echo "Container ${CONTAINER_NAME} started on host port ${HOST_PORT}"
                    // Wait for the container to be ready (bounded loop).
                    sh '''
                        for i in $(seq 1 15); do
                          if curl -sf ${HEALTH_URL} >/dev/null 2>&1; then echo "container up after ${i}s"; break; fi
                          sleep 1
                        done
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                sh 'curl -sf ${HEALTH_URL} | tee health-output.json'
                sh 'grep -q "\"status\":\"ok\"" health-output.json && echo "HEALTHY: status=ok" || (echo "UNHEALTHY" && exit 1)'
                echo "App is live at ${HEALTH_URL}"
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    // Best-effort: never let a failed stage leave containers behind.
                    try {
                        sh 'docker rm -f ${CONTAINER_NAME}'
                        sh 'docker image rm -f ${APP_IMAGE}:${APP_IMAGE_TAG} || true'
                    } catch (Exception e) {
                        echo "Cleanup had issues (${e.getMessage()}) - manual cleanup may be needed."
                    }
                }
            }
        }

    }

    post {
        success {
            echo 'Pipeline finished SUCCESSFULLY. 🎉'
            echo 'Open Blue Ocean (Jenkins > Open Blue Ocean) for a pretty visual of this run.'
        }
        failure {
            echo 'Pipeline FAILED. ⚠️ Check the console log for the failing stage.'
            echo 'Common fixes: see docs/troubleshooting.md in the repo.'
        }
        always {
            script {
                sh 'docker rm -f ${CONTAINER_NAME} 2>/dev/null || true'
            }
        }
    }
}
