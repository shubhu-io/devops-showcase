# ============================================================================
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in real values.
#   cp terraform.tfvars.example terraform.tfvars
# NEVER commit terraform.tfvars - it is gitignored (it may hold real IPs).
# ============================================================================

region              = "us-east-1"
project_name        = "terraform-aws-infrastructure"
environment         = "dev"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
instance_type       = "t3.micro"

# Name of an EXISTING EC2 key pair in us-east-1. Create one via the AWS
# console or: aws ec2 create-key-pair --key-name terraform-demo --query 'KeyMaterial' --output text > ~/.ssh/terraform-demo.pem
key_name            = "terraform-demo"

# Replace with YOUR public IP, e.g. 203.0.113.5/32 (use a /32 mask for one IP).
# Find it with: curl ifconfig.me
allowed_ssh_cidr    = "203.0.113.5/32"

instance_count      = 1

# Public Docker image used by user-data.sh. Default nginx listens on port 80
# inside the container, so app_internal_port stays 80.
app_image           = "nginx:latest"
app_port            = 3000
app_internal_port   = 80
