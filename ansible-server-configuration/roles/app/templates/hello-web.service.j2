[Unit]
Description=Hello Web (demo backend on 127.0.0.1:3000)
After=network.target

[Service]
Type=simple
User={{ web_user }}
Group={{ web_user }}
WorkingDirectory={{ web_root }}
ExecStart=/usr/bin/python3 -m http.server 3000 --bind 127.0.0.1 --directory {{ web_root }}
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths={{ web_root }}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
