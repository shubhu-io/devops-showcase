[web]
web1 ansible_host=203.0.113.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/your-key.pem
# web2 ansible_host=203.0.113.11 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/your-key.pem

[web:vars]
ansible_python_interpreter=/usr/bin/python3
